# ============================================================
# SIGNPOST SITE CONFIGURATION
# Copy this file to .env and change the values for each client.
# ============================================================

SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=False

# Domain / deployment
ALLOWED_HOSTS=example.co.zw,www.example.co.zw
CSRF_TRUSTED_ORIGINS=https://example.co.zw,https://www.example.co.zw
SECURE_SSL_REDIRECT=True
STATIC_URL=/static/
MEDIA_URL=/media/

# Quote requests
# Every request is saved in the admin inbox. These settings add an email to the business.
# Leave QUOTE_NOTIFY_EMAIL blank to turn emails off. Until EMAIL_BACKEND is set to SMTP,
# emails are only printed to the server log.
QUOTE_NOTIFY_EMAIL=
DEFAULT_FROM_EMAIL=noreply@example.co.zw
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.example.co.zw
# EMAIL_PORT=465
# EMAIL_HOST_USER=noreply@example.co.zw
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_SSL=True

# Brand
SITE_NAME=Your Business Name
TAGLINE=Professional services you can trust.
HERO_TITLE=Get the service you need, without the hassle.
HERO_TEXT=Tell customers what you do, where you are and how they can reach you.
ABOUT_TITLE=About Your Business
ABOUT_TEXT=Add a short, clear description of your business here. Keep it focused on who you serve, what you offer and what makes your service useful.
META_DESCRIPTION=Professional services from Your Business Name. Contact us on WhatsApp or visit us today.

# Contact
WHATSAPP_ORDER_NUMBER=263771234567
BUSINESS_PHONE_DISPLAY=+263 77 123 4567
BUSINESS_EMAIL=hello@example.co.zw
BUSINESS_ADDRESS=Your street address, City, Zimbabwe
OPENING_HOURS=Mon–Sat: 8:00 AM–5:00 PM

# Optional social links (leave blank if unused)
FACEBOOK_URL=
INSTAGRAM_URL=

# Theme - any valid CSS colour
BRAND_PRIMARY=#12A8E0
BRAND_DARK=#071C2C
BRAND_LIGHT=#F5FBFE

# Optional logo / hero image paths under static_src/images/
LOGO_IMAGE=images/brand/logo-placeholder.svg
HERO_IMAGE=images/hero-placeholder.svg

# Optional sample content seeded by the first migration. For the Chamboko demo leave
# SERVICES_JSON and BRANCHES_JSON out and use `loaddata chamboko_demo` instead.
# Services shown on the home page.
# You can add/remove service objects without touching templates.
SERVICES_JSON=[{"name":"Service One","description":"Short description of this service."},{"name":"Service Two","description":"Short description of this service."},{"name":"Service Three","description":"Short description of this service."}]

# Locations shown on the contact/location page.
# For exact Google Maps routing, use google_place_id when the business has a listing.
# Otherwise provide accurate latitude and longitude.
BRANCHES_JSON=[{"name":"Main Branch","address":"Your street address, City, Zimbabwe","phone":"","whatsapp_number":"","latitude":"","longitude":"","google_place_id":""}]
